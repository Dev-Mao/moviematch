# Copia este archivo como .env y completa los valores.
# El archivo .env real no se versiona (está en .gitignore).

# Clave secreta de Django. En producción usa una cadena larga y aleatoria.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Modo depuración. En producción debe ser False.
DJANGO_DEBUG=False

# Dominios permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=devmao.pythonanywhere.com

# Orígenes de confianza para CSRF (con esquema https), separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=https://devmao.pythonanywhere.com

# Solo para regenerar el catálogo desde TMDB en desarrollo (no se usa en producción).
TMDB_API_KEY=tu_clave_de_tmdb
